# Copy this file to ".env" for local testing. On Render, add these in the
# dashboard instead. NEVER put real values in this example file.

# REQUIRED
DISCORD_TOKEN=paste-your-bot-token-here
TARGET_CHANNEL_ID=123456789012345678

# OPTIONAL (defaults shown / built in)
# DISBOARD_BOT_ID=302050872383242240
# REMINDER_MESSAGE=🔔 Time to bump the server! Type `/bump` to bump it! 🚀
# REMINDER_KEYWORDS=bump now|time to bump|bump the server|/bump
# IGNORE_KEYWORDS=bump done|bump successful|bumped by|check it out on disboard|wait another|until the server can be bumped
# MIN_SECONDS_BETWEEN_REMINDERS=600
# DEBUG_LOG_DISBOARD=false
# LOG_LEVEL=INFO
